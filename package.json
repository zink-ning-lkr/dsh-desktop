{
  "name": "dsh-desktop",
  "productName": "DSH Desktop",
  "version": "0.6.0",
  "description": "DeepSeek Harness (dsh) 的桌面壳:后台启动 dsh web,窗口加载其 UI,数据与本体完全共享",
  "main": "main.js",
  "author": "zink-ning-lkr",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zink-ning-lkr/dsh-desktop.git"
  },
  "bugs": {
    "url": "https://github.com/zink-ning-lkr/dsh-desktop/issues"
  },
  "homepage": "https://github.com/zink-ning-lkr/dsh-desktop#readme",
  "keywords": [
    "electron",
    "deepseek",
    "dsh",
    "deepseek-harness",
    "desktop-app",
    "wrapper"
  ],
  "scripts": {
    "start": "electron .",
    "icon": "electron tools/rasterize-icon.js && powershell -NoProfile -ExecutionPolicy Bypass -File tools/resize-icons.ps1 && node tools/gen-icon.js",
    "dist": "node tools/clean-dist.js && electron-builder --win"
  },
  "devDependencies": {
    "electron": "^39.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.zinkning.dsh-desktop",
    "productName": "DSH Desktop",
    "copyright": "© zink-ning-lkr",
    "electronDist": "node_modules/electron/dist",
    "publish": {
      "provider": "github",
      "owner": "zink-ning-lkr",
      "repo": "dsh-desktop"
    },
    "files": [
      "main.js",
      "core.js",
      "dsh-process.js",
      "updates.js",
      "downloader.js",
      "diagnostics.js",
      "uitest.js",
      "ui.css",
      "ui-theme.js",
      "ui-icons.js",
      "shortcuts.js",
      "i18n.js",
      "i18n/**",
      "titlebar.html",
      "titlebar-preload.js",
      "reveal-tab.html",
      "menu.html",
      "menu-preload.js",
      "loading.html",
      "dsh-preload.js",
      "status.html",
      "status-preload.js",
      "dialog.html",
      "dialog-preload.js",
      "accel.html",
      "accel-preload.js",
      "welcome.html",
      "welcome-preload.js",
      "report.html",
      "report-preload.js",
      "assets/**"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "compression": "maximum",
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "DSH Desktop",
      "artifactName": "DSH-Desktop-Setup-${version}.exe"
    },
    "portable": {
      "artifactName": "DSH-Desktop-Portable-${version}.exe"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
